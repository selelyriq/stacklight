# ── Argument parsing ──────────────────────────────────────────────────────────
def parse_args():
    p = argparse.ArgumentParser(
        prog="cse",
        description="CloudFormation Change Set Explainer — plain-English deploy plans",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    p.add_argument("--stack-name", required=True, help="CloudFormation stack name")
    p.add_argument("--template-file", help="Path to CloudFormation template (YAML or JSON)")
    p.add_argument("--parameters", nargs="*", metavar="KEY=VALUE",
                   help="Parameter overrides, e.g. Env=prod DBSize=db.t3.large")
    p.add_argument("--capabilities", nargs="*",
                   default=["CAPABILITY_IAM", "CAPABILITY_NAMED_IAM", "CAPABILITY_AUTO_EXPAND"],
                   help="IAM capabilities (default: all three)")
    p.add_argument("--change-set-name", help="Change set name (auto-generated if omitted)")
    p.add_argument("--describe-only", action="store_true",
                   help="Explain an existing change set instead of creating a new one")
    p.add_argument("--execute", action="store_true",
                   help="Execute the change set after showing the plan")
    p.add_argument("--no-interactive", action="store_true",
                   help="Never prompt — show plan and exit (use with --execute to auto-deploy)")
    p.add_argument("--region", help="AWS region (overrides profile/env default)")
    p.add_argument("--profile", help="AWS profile name")
    p.add_argument("--no-color", action="store_true", help="Disable ANSI color output")
    p.add_argument("--no-ai", action="store_true",
                   help="Skip Claude API, use built-in explanations only")
    return p.parse_args()

# ── AWS helpers ───────────────────────────────────────────────────────────────
def get_cfn_client(region, profile):
    session_kwargs = {}
    if profile:
        session_kwargs["profile_name"] = profile
    session = boto3.Session(**session_kwargs)
    client_kwargs = {}
    if region:
        client_kwargs["region_name"] = region
    return session.client("cloudformation", **client_kwargs)

def stack_exists(cfn, stack_name):
    try:
        resp = cfn.describe_stacks(StackName=stack_name)
        status = resp["Stacks"][0]["StackStatus"]
        return status not in ("REVIEW_IN_PROGRESS",)
    except ClientError as e:
        if "does not exist" in str(e):
            return False
        raise

def create_change_set(cfn, stack_name, template_file, parameters, capabilities, change_set_name):
    kwargs = {
        "StackName": stack_name,
        "ChangeSetName": change_set_name,
        "Capabilities": capabilities,
    }

    if template_file:
        with open(template_file, "r") as f:
            kwargs["TemplateBody"] = f.read()
    else:
        kwargs["UsePreviousTemplate"] = True

    if parameters:
        kwargs["Parameters"] = []
        for param in parameters:
            if "=" in param:
                k, v = param.split("=", 1)
                kwargs["Parameters"].append({"ParameterKey": k, "ParameterValue": v})

    kwargs["ChangeSetType"] = "UPDATE" if stack_exists(cfn, stack_name) else "CREATE"

    cfn.create_change_set(**kwargs)
    return kwargs["ChangeSetType"]

def wait_for_change_set(cfn, stack_name, change_set_name, color):
    dots = ["⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"]
    i = 0
    while True:
        resp = cfn.describe_change_set(StackName=stack_name, ChangeSetName=change_set_name)
        status = resp["Status"]
        reason = resp.get("StatusReason", "")

        sys.stdout.write(f"\r  {dots[i % len(dots)]}  Creating change set... {DIM}{status}{RESET}   ")
        sys.stdout.flush()
        i += 1

        if status == "CREATE_COMPLETE":
            sys.stdout.write("\r  ✓  Change set ready                              \n")
            sys.stdout.flush()
            return resp
        elif status in ("FAILED", "DELETE_COMPLETE"):
            sys.stdout.write("\n")
            # No changes is a "failure" CFN reports as FAILED with a specific message
            if "didn't contain changes" in reason or "No updates are to be performed" in reason:
                print(c(GREEN, "\n  No changes detected — stack is already up to date.", color))
                sys.exit(0)
            print(c(RED, f"\n  Change set failed: {reason}", color))
            sys.exit(1)

        time.sleep(2)

def describe_change_set(cfn, stack_name, change_set_name):
    changes = []
    kwargs = {"StackName": stack_name, "ChangeSetName": change_set_name}
    while True:
        resp = cfn.describe_change_set(**kwargs)
        changes.extend(resp.get("Changes", []))
        next_token = resp.get("NextToken")
        if not next_token:
            break
        kwargs["NextToken"] = next_token
    return changes

# ── Change explanation logic ──────────────────────────────────────────────────
def explain_builtin(change):
    """Return a plain-English explanation using the built-in knowledge base."""
    rc = change["ResourceChange"]
    resource_type = rc["ResourceType"]
    action = rc["Action"]
    replacement = rc.get("Replacement", "False")

    knowledge = RESOURCE_KNOWLEDGE.get(resource_type)

    if knowledge:
        if action == "Add":
            label = knowledge["label"]
            explanation = f"New {label} will be created. No impact on existing resources."
            risk = "LOW"
        elif action == "Remove":
            explanation = knowledge["remove"]
            risk = knowledge["risk"]
        elif replacement in ("True", "Conditional"):
            explanation = knowledge["replace"]
            if replacement == "Conditional":
                explanation += " (replacement only happens if certain properties changed — check the details below)"
            risk = knowledge["risk"]
        else:
            explanation = knowledge["modify"]
            risk = knowledge["risk"]
    else:
        # Unknown resource type — generate something reasonable
        if action == "Add":
            explanation = f"New {resource_type} resource will be created."
            risk = "LOW"
        elif action == "Remove":
            explanation = f"{resource_type} resource will be deleted."
            risk = "MEDIUM"
        elif replacement in ("True", "Conditional"):
            explanation = f"{resource_type} will be replaced (deleted and recreated). Check for potential downtime."
            risk = "HIGH" if replacement == "True" else "MEDIUM"
        else:
            explanation = f"{resource_type} will be updated in-place."
            risk = "LOW"

    # List the changed properties
    details = rc.get("Details", [])
    changed_props = [
        d["Target"]["Attribute"] + (f".{d['Target'].get('Name','')}" if d["Target"].get("Name") else "")
        for d in details
        if d.get("Target", {}).get("Attribute")
    ]

    return explanation, risk, changed_props

def explain_with_claude(changes, stack_name):
    """Use Claude API to generate plain-English explanations for all changes."""
    try:
        import anthropic
    except ImportError:
        return None

    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        return None

    # Build a concise summary for Claude
    changes_summary = []
    for ch in changes:
        rc = ch["ResourceChange"]
        changes_summary.append({
            "action": rc["Action"],
            "resource_type": rc["ResourceType"],
            "logical_id": rc["LogicalResourceId"],
            "physical_id": rc.get("PhysicalResourceId", "new"),
            "replacement": rc.get("Replacement", "False"),
            "changed_properties": [
                d["Target"].get("Name") or d["Target"].get("Attribute", "")
                for d in rc.get("Details", [])
                if d.get("Target")
            ],
            "scope": rc.get("Scope", []),
        })

    prompt = f"""You are explaining a CloudFormation change set for the stack "{stack_name}" to an engineer before they deploy.

Here are the pending changes:
{json.dumps(changes_summary, indent=2)}

For each change, write a 1-2 sentence plain-English explanation that:
- Tells them what will actually happen (not just "resource will be modified")
- Calls out downtime, data loss, or service interruption risks clearly
- Mentions if a replacement will cause a new ARN/endpoint/DNS name
- Is direct and specific, not vague

Also assign a risk level: HIGH, MEDIUM, or LOW.

Respond with a JSON array, one object per change, in the same order. Each object:
{{
  "logical_id": "...",
  "explanation": "...",
  "risk": "HIGH|MEDIUM|LOW"
}}

JSON only, no markdown, no extra text."""

    try:
        client = anthropic.Anthropic(api_key=api_key)
        message = client.messages.create(
            model="claude-opus-4-6",
            max_tokens=2048,
            messages=[{"role": "user", "content": prompt}],
        )
        raw = message.content[0].text.strip()
        # Strip markdown code fences if present
        if raw.startswith("```"):
            raw = "\n".join(raw.split("\n")[1:])
        if raw.endswith("```"):
            raw = "\n".join(raw.split("\n")[:-1])
        return json.loads(raw)
    except Exception:
        return None

# ── Output formatting ─────────────────────────────────────────────────────────
def overall_risk(explanations_list):
    """Derive overall risk from non-ADD changes only; adds are always safe."""
    risks = [
        risk for ch, _exp, risk, _props in explanations_list
        if ch["ResourceChange"]["Action"] != "Add"
    ]
    if not risks:
        return "LOW"
    if "HIGH" in risks:
        return "HIGH"
    if "MEDIUM" in risks:
        return "MEDIUM"
    return "LOW"

import re as _re
_ANSI_ESCAPE = _re.compile(r"\033\[[0-9;]*m")

def _visible_len(text):
    return len(_ANSI_ESCAPE.sub("", text))

def print_header(stack_name, change_set_name, cs_type, color):
    width = 62
    border = c(CYAN, "╔" + "═" * width + "╗", color)
    footer = c(CYAN, "╚" + "═" * width + "╝", color)
    def row(text):
        pad = width - _visible_len(text) - 2
        return c(CYAN, "║ ", color) + text + " " * max(pad, 0) + c(CYAN, " ║", color)

    print()
    print(border)
    print(row(c(BOLD, "  cse — CloudFormation Change Set Explainer", color)))
    print(row(f"  Stack:      {c(BOLD, stack_name, color)}"))
    print(row(f"  Change set: {DIM if color else ''}{change_set_name}{RESET if color else ''}"))
    print(row(f"  Type:       {cs_type}"))
    print(footer)

def print_plan(stack_name, change_set_name, cs_type, changes, ai_explanations, color):
    print_header(stack_name, change_set_name, cs_type, color)

    # Build per-change explanations
    risks = []
    explanations = []
    for i, ch in enumerate(changes):
        rc = ch["ResourceChange"]
        builtin_exp, builtin_risk, changed_props = explain_builtin(ch)

        # Use AI explanation if available
        if ai_explanations:
            ai = next(
                (x for x in ai_explanations if x.get("logical_id") == rc["LogicalResourceId"]),
                None
            )
            if ai:
                exp = ai["explanation"]
                risk = ai.get("risk", builtin_risk)
            else:
                exp, risk = builtin_exp, builtin_risk
        else:
            exp, risk = builtin_exp, builtin_risk

        explanations.append((ch, exp, risk, changed_props))

    total_risk = overall_risk(explanations)
    adds    = sum(1 for ch, *_ in explanations if ch["ResourceChange"]["Action"] == "Add")
    modifies= sum(1 for ch, *_ in explanations if ch["ResourceChange"]["Action"] == "Modify")
    removes = sum(1 for ch, *_ in explanations if ch["ResourceChange"]["Action"] == "Remove")
    replacements = sum(
        1 for ch, *_ in explanations
        if ch["ResourceChange"].get("Replacement") in ("True", "Conditional")
    )

    # Summary line
    parts = []
    if adds:     parts.append(c(GREEN,  f"{adds} addition{'s' if adds > 1 else ''}",    color))
    if modifies: parts.append(c(YELLOW, f"{modifies} modification{'s' if modifies > 1 else ''}", color))
    if removes:  parts.append(c(RED,    f"{removes} removal{'s' if removes > 1 else ''}",  color))
    if replacements:
        parts.append(c(RED, f"{replacements} replacement{'s' if replacements > 1 else ''} ⚠", color))

    print()
    print(f"  {c(BOLD, 'SUMMARY', color)}: {len(changes)} change{'s' if len(changes) != 1 else ''} — {', '.join(parts)}")

    risk_col = RISK_COLORS.get(total_risk, RESET)
    print(f"  {c(BOLD, 'RISK', color)}:    {c(risk_col + BOLD, total_risk, color)}", end="")
    if total_risk == "HIGH":
        print(f"  {c(RED, '— review replacements and removals carefully', color)}", end="")
    elif total_risk == "MEDIUM":
        print(f"  {c(YELLOW, '— some changes may cause brief disruption', color)}", end="")
    else:
        print(f"  {c(GREEN, '— no high-risk changes detected', color)}", end="")
    print()

    # Per-change breakdown
    print()
    print(c(DIM, "  " + "─" * 60, color))

    for i, (ch, exp, risk, changed_props) in enumerate(explanations):
        rc = ch["ResourceChange"]
        action = rc["Action"]
        replacement = rc.get("Replacement", "False")
        resource_type = rc["ResourceType"]
        logical_id = rc["LogicalResourceId"]
        physical_id = rc.get("PhysicalResourceId", "")

        action_col = ACTION_COLORS.get(action, RESET)
        action_label = ACTION_LABELS.get(action, action.upper())
        risk_col = RISK_COLORS.get(risk, RESET)

        # Replacement badge
        repl_badge = ""
        if replacement == "True":
            repl_badge = c(RED + BOLD, " [REPLACEMENT]", color)
        elif replacement == "Conditional":
            repl_badge = c(YELLOW + BOLD, " [CONDITIONAL REPLACEMENT]", color)

        print()
        num = c(DIM, f"  {i+1}.", color)
        action_str = c(action_col + BOLD, action_label, color)
        risk_str   = c(risk_col, f"[{risk}]", color)
        print(f"{num} {action_str}  {c(BOLD, logical_id, color)}{repl_badge}  {risk_str}")
        print(f"     {c(DIM, resource_type, color)}", end="")
        if physical_id:
            print(f"  {c(DIM, '→ ' + physical_id, color)}", end="")
        print()

        # Wrap explanation at 70 chars
        words = exp.split()
        line = "     "
        for word in words:
            if len(line) + len(word) + 1 > 72:
                print(line)
                line = "     " + word + " "
            else:
                line += word + " "
        if line.strip():
            print(line)

        # Changed properties
        if changed_props:
            unique_props = sorted(set(p for p in changed_props if p))
            if unique_props:
                print(f"     {c(DIM, 'Changed: ' + ', '.join(unique_props[:8]), color)}", end="")
                if len(unique_props) > 8:
                    print(c(DIM, f" (+{len(unique_props)-8} more)", color), end="")
                print()

    print()
    print(c(DIM, "  " + "─" * 60, color))
    print()

# ── Execution ─────────────────────────────────────────────────────────────────
def execute_change_set(cfn, stack_name, change_set_name, color):
    print(c(CYAN, f"  Executing change set...", color))
    cfn.execute_change_set(StackName=stack_name, ChangeSetName=change_set_name)

    dots = ["⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"]
    i = 0
    terminal_statuses = {
        "UPDATE_COMPLETE", "CREATE_COMPLETE",
        "UPDATE_ROLLBACK_COMPLETE", "ROLLBACK_COMPLETE",
        "UPDATE_FAILED", "CREATE_FAILED",
        "ROLLBACK_FAILED", "UPDATE_ROLLBACK_FAILED",
    }
    while True:
        resp = cfn.describe_stacks(StackName=stack_name)
        status = resp["Stacks"][0]["StackStatus"]
        sys.stdout.write(f"\r  {dots[i % len(dots)]}  {status}                    ")
        sys.stdout.flush()
        i += 1
        if status in terminal_statuses:
            sys.stdout.write("\n")
            if "COMPLETE" in status and "ROLLBACK" not in status:
                print(c(GREEN, f"\n  ✓ Deploy complete: {status}", color))
            else:
                reason = resp["Stacks"][0].get("StackStatusReason", "")
                print(c(RED, f"\n  ✗ Deploy failed: {status}", color))
                if reason:
                    print(c(RED, f"    {reason}", color))
                sys.exit(1)
            break
        time.sleep(5)

def delete_change_set(cfn, stack_name, change_set_name):
    try:
        cfn.delete_change_set(StackName=stack_name, ChangeSetName=change_set_name)
    except ClientError:
        pass

# ── Main ──────────────────────────────────────────────────────────────────────
def main():
    args = parse_args()
    color = supports_color() and not args.no_color

    # Validate boto3
    try:
        import boto3
    except ImportError:
        print("Error: boto3 is required. Run: pip3 install boto3", file=sys.stderr)
        sys.exit(1)

    cfn = get_cfn_client(args.region, args.profile)

    # Change set name
    change_set_name = args.change_set_name or f"cse-{int(time.time())}-{uuid.uuid4().hex[:6]}"

    cs_type = "UPDATE"
    if not args.describe_only:
        if not args.template_file:
            print("Error: --template-file is required unless using --describe-only", file=sys.stderr)
            sys.exit(1)
        print(c(DIM, f"\n  Creating change set '{change_set_name}'...", color))
        try:
            cs_type = create_change_set(
                cfn, args.stack_name, args.template_file,
                args.parameters, args.capabilities, change_set_name
            )
        except ClientError as e:
            print(c(RED, f"\n  Error creating change set: {e}", color), file=sys.stderr)
            sys.exit(1)

        resp = wait_for_change_set(cfn, args.stack_name, change_set_name, color)
        cs_type = resp.get("ChangeSetType", cs_type)

    # Fetch changes
    try:
        changes = describe_change_set(cfn, args.stack_name, change_set_name)
    except ClientError as e:
        print(c(RED, f"\n  Error describing change set: {e}", color), file=sys.stderr)
        sys.exit(1)

    if not changes:
        print(c(GREEN, "\n  No changes in this change set.\n", color))
        if not args.describe_only:
            delete_change_set(cfn, args.stack_name, change_set_name)
        sys.exit(0)

    # Get AI explanations
    ai_explanations = None
    if not args.no_ai and os.environ.get("ANTHROPIC_API_KEY"):
        sys.stdout.write(c(DIM, "  Generating AI explanations...", color))
        sys.stdout.flush()
        ai_explanations = explain_with_claude(changes, args.stack_name)
        sys.stdout.write("\r" + " " * 40 + "\r")
        sys.stdout.flush()

    # Print the plan
    print_plan(args.stack_name, change_set_name, cs_type, changes, ai_explanations, color)

    if args.no_ai and not os.environ.get("ANTHROPIC_API_KEY"):
        pass  # built-in only, no nudge needed
    elif not os.environ.get("ANTHROPIC_API_KEY"):
        print(c(DIM, "  Tip: set ANTHROPIC_API_KEY for AI-powered explanations\n", color))

    # Execute decision
    should_execute = args.execute

    if not should_execute and not args.no_interactive and not args.describe_only:
        try:
            answer = input(c(CYAN, "  Execute this change set? [y/N] ", color)).strip().lower()
            should_execute = answer in ("y", "yes")
        except (KeyboardInterrupt, EOFError):
            print()
            should_execute = False

    if should_execute and not args.describe_only:
        execute_change_set(cfn, args.stack_name, change_set_name, color)
    elif not args.describe_only and not should_execute:
        print(c(DIM, f"  Change set preserved: {change_set_name}", color))
        print(c(DIM,  "  Execute later:  aws cloudformation execute-change-set \\", color))
        print(c(DIM, f"    --stack-name {args.stack_name} --change-set-name {change_set_name}\n", color))

if __name__ == "__main__":
    main()
