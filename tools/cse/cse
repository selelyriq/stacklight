#!/usr/bin/env python3
"""
cse — CloudFormation Change Set Explainer

Runs a CFN change set and rewrites the output in plain English so you
actually understand what's about to happen before you deploy.

Usage:
    cse --stack-name my-stack --template-file template.yaml
    cse --stack-name my-stack --template-file template.yaml --execute
    cse --stack-name my-stack --describe-only --change-set-name my-cs
    cse --stack-name my-stack --template-file template.yaml --no-interactive

Pipeline example:
    cse --stack-name $STACK --template-file $TEMPLATE --no-interactive --execute

Requires:
    pip3 install boto3

Optional (for AI-powered explanations):
    export ANTHROPIC_API_KEY=sk-ant-...
"""

